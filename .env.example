# PostgreSQL
DB_URL=postgresql://postgres:example@localhost:5433/copilot_db

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=rag-ingestion-group
KAFKA_TOPIC=rag.documents.ingestion.v1
KAFKA_SYNC_STATUS_TOPIC=rag.sync.status.v1
KAFKA_ENABLED=true

# Vectorizer gRPC
VECTORIZER_GRPC_TARGET=localhost:50051
VECTORIZER_GRPC_TIMEOUT=30
VECTOR_SIZE=1024

# OpenAI-compatible chat completions API
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1200

# Grounded answer thresholds
RAG_RETRIEVAL_LIMIT=8
RAG_AUTO_MERGE_THRESHOLD=0.5
RAG_MIN_RELEVANCE_SCORE=0.45
RAG_MIN_CONFIDENCE=0.6
RAG_MAX_CONTEXT_CHARS=24000
